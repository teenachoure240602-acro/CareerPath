# ─── AI Career Analysis ───────────────────────────────────────
# Required: API key for the AI service that generates career recommendations.
# Get one at https://console.anthropic.com/settings/keys
AI_API_KEY=

# Optional overrides (defaults shown):
# AI_BASE_URL=https://api.anthropic.com
# AI_MODEL=claude-haiku-4-5-20251001
# AI_CUSTOM_HEADERS=  (comma-separated Key:Value pairs)

# ─── Gemini / Gemma Career Insight ─────────────────────────────
# Required: API key for Google Gemini API (used by the gemini-career-insight edge function).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default: gemma-3-27b-it)
# GEMINI_MODEL=gemma-3-27b-it

# ─── Supabase ─────────────────────────────────────────────────
# Provided by the Bolt environment — do not change unless directed.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
